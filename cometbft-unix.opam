opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Unix entry points for the OCaml CometBFT ABCI server"
description: """
Instantiates the flow-generic servers in cometbft-lwt against Unix sockets,
using mirage-flow-unix to supply the Mirage_flow.S the functors ask for. This
is the package an ordinary (non-unikernel) OCaml application chain links
against; it is also the only package in the repository allowed to depend on
unix.

Listens on TCP or a Unix domain socket, matching CometBFT's proxy_app settings
(tcp://127.0.0.1:26658, unix:///tmp/abci.sock).
"""
maintainer: ["gilbahat"]
authors: ["gilbahat"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cometbft"
bug-reports: "https://github.com/reuna-labs/ocaml-cometbft/issues"
dev-repo: "git+https://github.com/reuna-labs/ocaml-cometbft.git"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "cometbft-lwt" {= version}
  "cometbft-grpc" {= version}
  "lwt"
  "mirage-flow-unix" {>= "4.0.0"}
  "h2" {>= "0.13.0"}
  "h2-lwt-unix" {>= "0.13.0"}
  "grpc-lwt" {>= "0.2.0"}
  "logs"
  "alcotest" {with-test}
]
build: [["dune" "build" "-p" name "-j" jobs]]

# opam does not apply pin-depends transitively: pinning cometbft does not pin
# what cometbft's own pin-depends name. So each package names its whole sibling
# closure, not just its direct edges, or resolution fails with
#   cometbft -> cometbft-proto unknown package
pin-depends: [
  [ "cometbft.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-cometbft.git#main" ]
  [ "cometbft-proto.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-cometbft.git#main" ]
  [ "cometbft-lwt.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-cometbft.git#main" ]
  [ "cometbft-grpc.0.1.0~alpha1" "git+https://github.com/reuna-labs/ocaml-cometbft.git#main" ]
  # The released grpc.0.2.0 caps h2 < 0.13.0; see the note above. This was
  # a comment telling the reader to run `opam pin add` by hand, which meant
  # every consumer had to know. Now it resolves on its own.
  [ "grpc.0.2.1~alpha1" "git+https://github.com/reuna-labs/ocaml-grpc.git#4dc74e8" ]
  [ "grpc-lwt.0.2.1~alpha1" "git+https://github.com/reuna-labs/ocaml-grpc.git#4dc74e8" ]
]
